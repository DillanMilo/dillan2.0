# Use a dedicated Sending access key restricted to dillanmilo.com.
RESEND_API_KEY=re_your_api_key_here

# Cloudflare Turnstile: the VITE_ value is public; keep the secret server-only.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Optional comma-separated overrides.
TURNSTILE_ALLOWED_HOSTNAMES=dillanmilo.com,www.dillanmilo.com
CONTACT_ALLOWED_ORIGINS=https://dillanmilo.com,https://www.dillanmilo.com
